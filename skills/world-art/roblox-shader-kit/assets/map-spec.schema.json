{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codex.local/roblox-shader-kit/map-spec.schema.json",
  "title": "RobloxShaderKit MapSpec",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "source", "materials", "surfaces", "parts", "chunks", "camera", "evidence"],
  "properties": {
    "schema": { "const": 1 },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["reference-image", "reference-project", "hybrid"] },
        "notes": { "type": "string" }
      }
    },
    "materials": {
      "type": "object",
      "additionalProperties": false,
      "required": ["shared", "families"],
      "properties": {
        "shared": { "type": "boolean" },
        "families": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "separation_reason": { "type": "string" }
      }
    },
    "surfaces": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "slot", "flags", "color_linear"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "slot": { "type": "integer", "minimum": 0, "maximum": 4 },
          "flags": { "type": "integer", "minimum": 0, "maximum": 31 },
          "color_linear": { "type": "array", "prefixItems": [{"type":"number"},{"type":"number"},{"type":"number"},{"type":"number"}], "minItems": 4, "maxItems": 4 },
          "checker_tiling": { "type": "number", "exclusiveMinimum": 0 },
          "scroll": { "type": "array", "prefixItems": [{"type":"number"},{"type":"number"}], "minItems": 2, "maxItems": 2 },
          "emission": { "type": "number", "minimum": 0 }
        }
      }
    },
    "parts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "geometry", "surface", "material_family", "dynamic", "chunk"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "geometry": { "type": "string", "minLength": 1 },
          "mesh": { "type": "string" },
          "transform": { "type": "array", "minItems": 10, "maxItems": 10, "items": {"type":"number"} },
          "surface": { "type": "string", "minLength": 1 },
          "material_family": { "type": "string", "minLength": 1 },
          "dynamic": { "type": "boolean" },
          "collision": { "type": "boolean" },
          "chunk": { "type": "string", "minLength": 1 },
          "lod": { "type": "string" }
        }
      }
    },
    "chunks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "bounds"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "bounds": { "type": "array", "minItems": 6, "maxItems": 6, "items": {"type":"number"} },
          "cull_distance": { "type": "number", "exclusiveMinimum": 0 }
        }
      }
    },
    "camera": {
      "type": "object",
      "additionalProperties": false,
      "required": ["position", "target", "fov"],
      "properties": {
        "position": { "type": "array", "minItems": 3, "maxItems": 3, "items": {"type":"number"} },
        "target": { "type": "array", "minItems": 3, "maxItems": 3, "items": {"type":"number"} },
        "fov": { "type": "number", "exclusiveMinimum": 1, "exclusiveMaximum": 180 },
        "aspect": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["fact", "status", "source"],
        "properties": {
          "fact": { "type": "string", "minLength": 1 },
          "status": { "enum": ["verified", "inferred", "unknown"] },
          "source": { "type": "string", "minLength": 1 },
          "impact": { "type": "string" }
        }
      }
    }
  }
}
